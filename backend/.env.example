# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit real keys.
# Real environment variables always win over this file.

# ---- Run mode -------------------------------------------------------------------------------------
# demo: seeded simulator on a simulated clock (fresh world on every start)
# live: wall-clock time, simulator off, state rebuilt from the durable event log on every start
LEADPILOT_MODE=demo
LEADPILOT_PERSIST=1
# LEADPILOT_WARMUP_DAYS=21

# ---- Database -------------------------------------------------------------------------------------
# Empty → local SQLite at backend/var/leadpilot.db (override the file with LEADPILOT_DB).
# Supabase: Project Settings → Database → Connection string → Session pooler (port 5432). postgresql:// is fine.
# Tables are created by supabase/migrations/ on first start.
# LEADPILOT_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Postgres schema for LeadPilot's tables. Keep demo and live data apart, e.g. demo → LEADPILOT_DB_SCHEMA=demo.
# LEADPILOT_DB_SCHEMA=public
# The server refuses to start demo mode on live data (and vice versa); set 1 only if you really mean it.
# LEADPILOT_ALLOW_MODE_SWITCH=0
# make test-pg runs the Postgres tests in a throwaway schema (leadpilot_test) of this database.
# LEADPILOT_TEST_DB_URL=

# ---- Sign-in (Supabase Auth) -----------------------------------------------------------------------
# auto (default): logins are required whenever Supabase is configured. on | off to force. Live mode refuses
# to start without logins unless LEADPILOT_AUTH=off is set explicitly.
# LEADPILOT_AUTH=auto
# Worked out from LEADPILOT_DB_URL for Supabase pooler URLs; set it only if that guess is wrong.
# SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings → API Keys → anon / publishable key. Safe in the browser: row level security blocks it.
# SUPABASE_ANON_KEY=
# Comma-separated. These people are admins as soon as they sign in (how the first admin gets in).
# LEADPILOT_ADMIN_EMAILS=you@company.com
# Only for older projects that sign tokens with a shared secret (new projects use public ES256 keys).
# SUPABASE_JWT_SECRET=

# ---- Calls (Phase 8): Gemini summaries, Retell webhooks, recordings ----------------------------------
# Google AI Studio → Get API key. Without it, calls are still logged; outcomes come from the phone system or rules.
# GEMINI_API_KEY=
# Any Gemini model that supports JSON output; the default is gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
# Retell signs its webhooks with your Retell API key (Retell dashboard → API Keys). Needed for a Retell connector.
# RETELL_API_KEY=
# Keep private copies of call recordings in Supabase Storage (Project Settings → API Keys → service_role / secret).
# Server only: it bypasses row level security. Without it, the phone system's own recording link is used.
# SUPABASE_SERVICE_ROLE_KEY=
# LEADPILOT_RECORDINGS_BUCKET=call-recordings

# ---- Notification channels (Phase 7; each stays off until its keys are set) -----------------------
# Who gets what is in backend/config/notifications.yaml. In-app notifications need nothing.
# Email via Resend (resend.com → API Keys). The sender must be on a domain you verified in Resend.
# RESEND_API_KEY=
# LEADPILOT_EMAIL_FROM=LeadPilot <notifications@yourcompany.com>
# Slack: create an app → Incoming Webhooks → add one for the channel your team watches.
# SLACK_WEBHOOK_URL=
# SMS via Twilio (console → Account Info). The sender is a Twilio number in E.164 form, e.g. +15005550006.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# The dashboard's address, so emails, Slack posts and texts link straight to the lead or deal, and emailed quotes
# link to the buyer's quote page.
# LEADPILOT_PUBLIC_URL=https://leadpilot.yourcompany.com
# Demo mode only notifies in the app (simulated leads should not email or text real people). 1 = deliver anyway.
# LEADPILOT_NOTIFY_IN_DEMO=0
